# AquaRack Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ==========================================================
# DATABASE
# ==========================================================
DATABASE_URL=your_cockroachdb_connection_string_here
# For cloud deployments, the system will automatically use 'sslrootcert=system'
# For local development with specific certificates, set:
# COCKROACH_CERT=/path/to/your/root.crt

# ==========================================================
# AI SERVICES
# ==========================================================
COHERE_API_KEY=your_cohere_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ==========================================================
# AWS SERVICES
# ==========================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=eu-central-1
S3_BUCKET=rackpulse-cold-storage-eu-central-1
S3_ENABLED=true
CLOUDWATCH_ENABLED=true

# ==========================================================
# GENERAL
# ==========================================================
API_TOKEN=your_api_token_here
AQUARACK_DEVICE_ID=rack-01-primary
COLLECTOR_API_URL=http://127.0.0.1:8000  # For cloud deployments, use: https://your-app.onrender.com

# ==========================================================
# FRONTEND CONFIG
# ==========================================================
VITE_API_BASE_URL=https://aquarack.onrender.com